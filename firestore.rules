rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // JWT custom-claim check. Request-level → can authorize list/aggregation queries.
    function isAdminToken() {
      return isLoggedIn() && request.auth.token.admin == true;
    }

    // Full admin check (document-level operations may use get()).
    // get() cannot authorize queries, so list rules use isAdminToken() instead.
    function isAdmin() {
      return isAdminToken() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isChatParticipant(chatData) {
      return request.auth.uid == chatData.userId ||
             request.auth.uid == chatData.providerId;
    }

    function isParticipantOfChat(chatId) {
      let chat = get(/databases/$(database)/documents/chats/$(chatId)).data;
      return request.auth.uid == chat.userId || request.auth.uid == chat.providerId;
    }

    // ── Users collection ──────────────────────────
    match /users/{userId} {
      // Anyone logged in can read public profile fields (not phone)
      allow read: if isLoggedIn();

      // Only owner or admin can write
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Providers collection ──────────────────────
    match /providers/{providerId} {
      // Anyone (including guests) can read providers — public listing
      allow read: if true;

      // Only the owning user can create their own provider profile
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;

      // Owner can update availability, pic, etc. Admin can update verification
      allow update: if isLoggedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── Chats collection ─────────────────────────
    match /chats/{chatId} {
      // doc-level read
      allow get: if isLoggedIn() && (isChatParticipant(resource.data) || isAdmin());

      // query-level read: participant filters their own chats, admins read all
      allow list: if isLoggedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.providerId ||
        isAdminToken()
      );

      // Any logged-in user can create a chat (with themselves as userId)
      allow create: if isLoggedIn() &&
        request.resource.data.userId == request.auth.uid;

      // Only participants or admin can update (e.g., agreement state, status)
      allow update: if isLoggedIn() && (isChatParticipant(resource.data) || isAdmin());

      allow delete: if isAdmin();

      // ── Messages subcollection ─────────────────
      match /messages/{messageId} {
        // Only chat participants or admin can read/write messages
        allow get, write: if isLoggedIn() && (isParticipantOfChat(chatId) || isAdmin());
        allow list: if isLoggedIn() && (isParticipantOfChat(chatId) || isAdminToken());
      }
    }

    // ── Jobs collection ──────────────────────────
    match /jobs/{jobId} {
      allow get: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isLoggedIn() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.providerId ||
        isAdminToken()
      );

      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
    }

    // ── Ratings collection ───────────────────────
    match /ratings/{ratingId} {
      allow read: if isLoggedIn();
      // Only the "from" user can create a rating
      allow create: if isLoggedIn() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────
    match /notifications/{notifId} {
      // Recipient or admin can read (doc-level)
      allow get: if isLoggedIn() && (
        resource.data.toUserId == request.auth.uid || isAdmin()
      );

      // Recipient or admin can query their own notifications
      allow list: if isLoggedIn() && (
        request.auth.uid == resource.data.toUserId || isAdminToken()
      );

      // Admin (or Cloud Functions) can create notifications
      allow create: if isAdmin();

      // Only recipient can mark as read
      allow update: if isLoggedIn() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // ── Reports ──────────────────────────────────
    match /reports/{reportId} {
      allow get: if isAdmin();
      allow list: if isAdminToken();
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // ── Broadcast Jobs ───────────────────────────
    match /broadcast_jobs/{jobId} {
      allow get: if isAdmin();
      allow list: if isAdminToken();
      allow create, update, delete: if isAdmin();
    }

    // ── Categories collection ────────────────────
    match /categories/{categoryId} {
      // Anyone can read categories (needed for home screen)
      allow read: if true;
      // Only admins can manage categories
      allow write: if isAdmin();
    }
  }
}